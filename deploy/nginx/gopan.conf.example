# 宿主 nginx 反代 gopan(精简档:COMPOSE_PROFILES 不含 caddy)。
# 放到 /etc/nginx/conf.d/pan.example.com.conf,改掉域名和证书路径,nginx -t && systemctl reload nginx。
#
# 两条铁律,破一条就是 403 或上传失败:
#   1. proxy_set_header Host $host —— 预签名 URL 把 Host 和路径一起签进了 S3 V4 签名,改任何一样都 403。
#   2. client_max_body_size ≥ 分片大小(GOPAN_PART_SIZE 默认 16MiB)。
# 若改了 GOPAN_S3_BUCKET,下面的 /gopan/ 路由要同步改成新 bucket 名。

server {
    listen 80;
    listen [::]:80;
    server_name pan.example.com;

    # acme.sh 的 webroot 校验(和本机其它站点保持一致即可)
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name pan.example.com;

    ssl_certificate     /root/.acme.sh/pan.example.com_ecc/fullchain.cer;
    ssl_certificate_key /root/.acme.sh/pan.example.com_ecc/pan.example.com.key;

    # 分片 16MiB,留一倍余量
    client_max_body_size 32m;

    # 预签名直传/直取:/{bucket}/* → MinIO。不剥前缀,Host 原样透传。
    location /gopan/ {
        proxy_pass http://127.0.0.1:19000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 上传别在 nginx 落盘、下载别攒缓冲:大文件要流式过
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # GraphQL / SPA / 分享页 /s / 打包下载 /pack
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # /pack 是边打包边吐的长响应,同样不缓冲
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "useDefineForClassFields": true,
    "types": ["vite/client", "node", "element-plus/global"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@yophon/tau-kernel": ["src/vendor/tau/kernel/index.d.ts"],
      "@yophon/tau-ext-mcp-http": ["src/vendor/tau/ext-mcp-http/index.d.ts"],
      "@yophon/tau-ext-provider-anthropic": ["src/vendor/tau/ext-provider-anthropic/index.d.ts"],
      "@yophon/tau-ext-provider-google": ["src/vendor/tau/ext-provider-google/index.d.ts"],
      "@yophon/tau-ext-provider-openai-responses": ["src/vendor/tau/ext-provider-openai-responses/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "codegen.ts"]
}

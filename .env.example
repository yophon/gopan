# 复制成 .env 再改:cp .env.example .env
# 另需 secrets/jwt_secret(≥32 字节):openssl rand -base64 48 > secrets/jwt_secret

# ---------- 必填 ----------
GOPAN_DOMAIN=pan.example.com
POSTGRES_PASSWORD=改成随机长串
MINIO_ROOT_PASSWORD=改成随机长串,同时是 S3 secret

# ---------- 部署档位:选一档,把另一档整段注释掉 ----------

# 档 A · 全家桶(4C8G / 4G+ 内存,机器上没有别的反代)
# Office 在线预览 + 自带 Caddy 自动证书,什么都不用额外配。
COMPOSE_PROFILES=office,caddy

# 档 B · 精简(2G 小机,或 80/443 已被宿主 nginx 占用)
# 关掉 Gotenberg(省 300~500MB 常驻)和 Caddy(反代交给宿主,见 deploy/nginx/gopan.conf.example)。
# 代价只有一个:Office 文件不出在线预览,前端提示下载;图片/视频/PDF/文本预览不受影响。
#COMPOSE_PROFILES=
#GOPAN_GOTENBERG_URL=            # 必须显式留空:告诉后端别再入队 Office 转换任务
#GOPAN_HTTP_BIND=127.0.0.1:18080 # 宿主 nginx 转这里(默认值,端口冲突时改)
#MINIO_S3_BIND=127.0.0.1:19000   # 宿主 nginx 把 /gopan/* 转这里
#GOPAN_MEM_LIMIT=384m
#MINIO_MEM_LIMIT=512m
#PG_MEM_LIMIT=384m
#PG_SHARED_BUFFERS=32MB
#PG_MAX_CONNECTIONS=30

# 想在小机上保留 Office 预览:COMPOSE_PROFILES=office,给它上枷锁并留够 swap
#GOTENBERG_MEM_LIMIT=512m

# ---------- 应用 ----------
# 首个账号注册完改成 false,再 up -d 一次
GOPAN_REGISTER_OPEN=true
# 每用户默认配额(字节)。默认 100GB;磁盘小务必调低——盘满是全机一起宕,不只是云盘。
# 5GB = 5368709120,10GB = 10737418240
#GOPAN_DEFAULT_QUOTA=107374182400

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 登录态存在 EncryptedSharedPreferences,密钥绑定本机 Keystore,备份到别的设备也解不开,索性不备份;
         targetSdk 31+ 时 allowBackup=false 挡不住设备间迁移(D2D),由 dataExtractionRules 全部排除 -->
    <application
        android:name=".GopanApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Gopan"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="tiramisu">

        <!-- singleTop 而非 singleTask:Yophon ID 授权页(Custom Tab)在同一任务里,
             singleTask 会让「从桌面图标回到 App」清掉它,登录被静默取消 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AppAuth 的 RedirectUriReceiverActivity 由库 manifest 合并,scheme 由 build.gradle.kts 的
             manifestPlaceholders["appAuthRedirectScheme"] 提供(xyz.yophon.gopan:/oauthredirect) -->
    </application>
</manifest>

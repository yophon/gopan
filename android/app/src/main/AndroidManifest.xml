<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 上传 / 下载在前台服务里跑(WorkManager 长任务,dataSync 类型),通知栏显示进度 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 音频预览的后台播放(Media3 会话服务,播放时前台服务 + 带控制按钮的通知) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- App 内更新:把站点发布的安装包交给系统安装器(不经应用商店分发) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 8–9 没有 MediaStore.Downloads,保存到公共「下载」目录需要它;10+ 不需要 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 登录态存在 EncryptedSharedPreferences,密钥绑定本机 Keystore,备份到别的设备也解不开,索性不备份;
         targetSdk 31+ 时 allowBackup=false 挡不住设备间迁移(D2D),由 dataExtractionRules 全部排除 -->
    <application
        android:name=".GopanApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Gopan"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="tiramisu">

        <!-- singleTop 而非 singleTask:Yophon ID 授权页(Custom Tab)在同一任务里,
             singleTask 会让「从桌面图标回到 App」清掉它,登录被静默取消 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 系统分享「存到 gopan」:文本进传输助手草稿,文件问去处(发到传输助手 / 存到文件夹) -->
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- 系统分享菜单的「剪藏到 gopan」(doc/23 五.3):压在浏览器上的半透明卡片,剪完回浏览器。
             本身不接 Intent,由下面的 activity-alias 带着自己的名字和图标出现在分享菜单里(只接 text/plain,
             没有网址时卡片里说明);上面「发到传输助手」的入口不变。taskAffinity 为空:分享方带 NEW_TASK 启动时
             也不会把 gopan 已开着的任务拉到前面,关掉卡片直接回到浏览器 -->
        <activity
            android:name=".feature.clips.ClipShareActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Gopan.Sheet"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode" />
        <activity-alias
            android:name=".ClipShareTarget"
            android:exported="true"
            android:icon="@mipmap/ic_clip_share"
            android:label="@string/clip_share_label"
            android:targetActivity=".feature.clips.ClipShareActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- 长按图标的「上传文件」、小组件的「发照片」「发文件」:透明的一页,只弹系统选择器,选好入队就关。
             taskAffinity 为空、不进最近任务:选完回到原来的桌面 -->
        <activity
            android:name=".feature.shortcut.QuickActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Gopan.Sheet" />

        <!-- 桌面小组件「传输助手」 -->
        <receiver
            android:name=".feature.shortcut.ChatWidgetProvider"
            android:exported="false"
            android:label="@string/widget_chat_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_chat_info" />
        </receiver>

        <!-- 拍照落点与「用其他应用打开」交给其它应用时用的 content:// -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager 的前台服务:Android 14 起必须声明类型 -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- 音频预览的后台播放:exported 供系统媒体控制(通知、锁屏、蓝牙按键)连接会话 -->
        <service
            android:name=".feature.preview.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- 系统「文件」App 与其它应用的「打开文件 / 另存为」面板里的 gopan(Storage Access Framework) -->
        <provider
            android:name=".core.documents.GopanDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- AppAuth 的 RedirectUriReceiverActivity 由库 manifest 合并,scheme 由 build.gradle.kts 的
             manifestPlaceholders["appAuthRedirectScheme"] 提供(xyz.yophon.gopan:/oauthredirect) -->
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小组件「传输助手」(ChatWidgetProvider):左边打开传输助手,右边发照片、发文件 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:id="@+id/widget_open"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="@string/widget_chat_open"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_chat" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_chat_title"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_photo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_btn"
        android:contentDescription="@string/widget_chat_photo"
        android:padding="9dp"
        android:src="@drawable/ic_widget_photo" />

    <ImageView
        android:id="@+id/widget_file"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_btn"
        android:contentDescription="@string/widget_chat_file"
        android:padding="9dp"
        android:src="@drawable/ic_widget_file" />
</LinearLayout>

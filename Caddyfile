# 预签名 URL 形如 https://{域名}/{bucket}/{key}?X-Amz-...(minio-go 对自定义域用 path-style,
# bucket 名就在路径里),所以按 /gopan/* 匹配转 MinIO,不剥前缀、透传 Host——
# S3 V4 签名把 Host 和路径都签进去了,改任何一样都是 403。
{$GOPAN_DOMAIN} {
	encode gzip

	@s3 path /gopan/*
	handle @s3 {
		# 对象响应与站点同源,却不经过 gopan、没有站点的 CSP:不许它们作为页面执行脚本(doc/20 二.6)。
		# defer:盖掉 MinIO 自己带的同名头
		header {
			defer
			Content-Security-Policy "sandbox; default-src 'none'; img-src 'self' data:; media-src 'self'; style-src 'unsafe-inline'"
			X-Content-Type-Options nosniff
		}
		reverse_proxy minio:9000
	}

	handle {
		reverse_proxy gopan:8080
	}
}

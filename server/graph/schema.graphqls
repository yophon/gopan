scalar Time
scalar Int64

# ---------- 对象 ----------

type User {
  id: ID!
  username: String!
  quotaBytes: Int64!
  usedBytes: Int64!
  isAdmin: Boolean!
}

# 一个登录设备(按 refresh token family 分组)。
type Session {
  familyId: ID!
  # 原始 UA(服务端截断到 512 字节),展示时由前端归类成"Chrome · Windows"这种
  userAgent: String!
  ip: String!
  createdAt: Time!
  lastSeenAt: Time!
  # 被吊销的时刻:改密、管理员禁用、重放检测触发整族吊销
  revokedAt: Time
  # 这族 refresh token 还能不能用
  active: Boolean!
  # 是不是当前这个请求所在的会话(access token 里的 fid)
  current: Boolean!
}

# ---------- WebDAV 应用密码 ----------

type AppPassword {
  id: ID!
  name: String!
  createdAt: Time!
  lastUsedAt: Time
}

type MCPAPIKey {
  id: ID!
  name: String!
  scopes: [String!]!
  createdAt: Time!
  lastUsedAt: Time
}

type MCPAPIKeyCreated {
  token: String!
  credential: MCPAPIKey!
}

type OAuthGrant {
  id: ID!
  clientId: String!
  clientName: String!
  scopes: [String!]!
  createdAt: Time!
  updatedAt: Time!
}

type OAuthAuthorizationRequest {
  clientName: String!
  scopes: [String!]!
}

type OAuthAuthorizationResult {
  redirectUrl: String!
}

# ---------- 管理端(所有 admin* 字段要求调用者 is_admin,校验在 service 层) ----------

type AdminUser {
  id: ID!
  username: String!
  isAdmin: Boolean!
  disabled: Boolean!
  quotaBytes: Int64!
  usedBytes: Int64!
  createdAt: Time!
}

type TaskCount {
  status: String!
  count: Int!
}

type AdminOverview {
  userCount: Int!
  totalUsedBytes: Int64!
  blobCount: Int!
  blobBytes: Int64!
  taskCounts: [TaskCount!]!
  contentIndex: ContentIndexStats!
}

# 内容搜索的索引进度(doc/20)。按内容(blob)计,同一份内容多个文件共享一份。
type ContentIndexStats {
  # GOPAN_CONTENT_INDEX 关掉时为 false,其余数字照旧给出
  enabled: Boolean!
  done: Int!
  # 支持的格式但没有文字(扫描件、空文档)
  empty: Int!
  # 文字太长只收了前一部分
  truncated: Int!
  unsupported: Int!
  failed: Int!
  # 还没提过或提取器版本旧了,等着排队的
  pending: Int!
  textBytes: Int64!
}

enum NodeKind { FILE, FOLDER }

type Node {
  id: ID!
  parentId: ID
  name: String!
  kind: NodeKind!
  size: Int64
  mime: String
  sha256: String
  createdAt: Time!
  updatedAt: Time!
  deletedAt: Time
  # 回收站里的节点:预计被彻删的时刻(deleted_at + GOPAN_TRASH_TTL)。
  # 只有 trash 查询会填,其它路径一律 null —— 让前端不必知道运维配的保留期是多少。
  purgeAt: Time
  preview: PreviewInfo!
  downloadUrl: String
  # 子树统计(仅文件夹;异步重算,statsStale=true 表示数字可能滞后)
  subtreeBytes: Int64
  subtreeCount: Int64
  statsStale: Boolean
}

# ARCHIVE:压缩包(zip / 7z / rar / tar.*),用 archiveInfo / archiveEntries 浏览
enum PreviewKind { NONE, IMAGE, PDF, NATIVE_PDF, VIDEO, AUDIO, TEXT, OFFICE, ARCHIVE }

type PreviewInfo {
  kind: PreviewKind!
  thumbUrl: String
  largeUrl: String
  contentUrl: String
  status: TaskStatus
  durationSec: Int
}

# UNAVAILABLE:该派生能力未在本次部署中启用(如未部署 Gotenberg 时的 Office 转换)
enum TaskStatus { PENDING, RUNNING, DONE, FAILED, UNAVAILABLE }

type NodePage {
  items: [Node!]!
  nextCursor: String
  total: Int!
}

# 内容搜索的一条结果(doc/20 第三节)
type ContentHit {
  node: Node!
  # 第一处命中前后的一段原文,两头被截时带"…"
  snippet: String!
  # 片段里每处命中的位置(按字符)
  highlights: [TextRange!]!
  # 命中所在页(PDF / 由 Office 转出的 PDF);其余格式为 null
  page: Int
}

type TextRange {
  start: Int!
  length: Int!
}

# 不返回 total:要把所有候选都复核一遍才数得出来,代价高
type ContentHitPage {
  items: [ContentHit!]!
  nextCursor: String
}

type UploadInit {
  instant: Boolean!
  node: Node
  session: UploadSession
}

type UploadSession {
  id: ID!
  partSize: Int!
  partUrls: [PartUrl!]!
  uploadedParts: [Int!]!
  expiresAt: Time!
  status: String!
}

type PartUrl {
  partNumber: Int!
  url: String!
}

type Share {
  id: ID!
  token: String!
  node: Node!
  hasPassword: Boolean!
  expiresAt: Time
  createdAt: Time!
  # 访问统计。没有访问时返回全零对象(非空,前端不用判空)。
  visitStats: ShareVisitStats!
}

# 一条分享访问记录。
type ShareVisit {
  # verify(访客进入)/ download(单文件下载)/ pack(打包下载)
  kind: String!
  ip: String
  userAgent: String
  createdAt: Time!
}

# 分享的访问汇总。
#
# 计数是**近 180 天**的:worker 会清理更早的记录,别当成历史总量。
# downloadCount 的语义是"发起了下载"(下载走预签名直连对象存储,服务端观测不到
# 完成时刻),单文件下载与打包合计在这里。
type ShareVisitStats {
  verifyCount: Int64!
  downloadCount: Int64!
  lastVisitAt: Time
  lastVisitKind: String
}

type ShareInfo {
  token: String!
  name: String!
  kind: NodeKind!
  needPassword: Boolean!
  expired: Boolean!
}

type AuthPayload {
  accessToken: String!
  user: User!
}

# 访客凭证:不返回 User,避免向访客泄露属主信息
type ShareAuth {
  accessToken: String!
}

# ---------- 收集文件(doc/20):对文件夹开链接,访客不登录往里传,只写不读 ----------

type FileRequest {
  id: ID!
  token: String!
  folder: Node!
  title: String!
  note: String!
  hasPassword: Boolean!
  requireName: Boolean!
  groupByUploader: Boolean!
  # 上限,null = 不限
  maxFileSize: Int64
  maxTotalBytes: Int64
  maxFiles: Int
  expiresAt: Time
  createdAt: Time!
  # 收件统计(按收件记录算,文件删了也算)
  fileCount: Int!
  totalBytes: Int64!
  uploaderCount: Int!
  # 属主上次查看收件记录之后新收到的个数
  newCount: Int!
  lastUploadAt: Time
}

type FileRequestUpload {
  id: ID!
  fileName: String!
  size: Int64!
  # 访客自填,可能为空
  uploaderName: String!
  ip: String
  userAgent: String
  createdAt: Time!
  # 文件还在时给出节点;进了回收站或彻删后为 null
  node: Node
}

type FileRequestUploadPage {
  items: [FileRequestUpload!]!
  nextCursor: String
}

# 整表单提交:没给的上限 = 不限。密码与目标文件夹创建后不能改。
input FileRequestInput {
  title: String!
  note: String
  requireName: Boolean
  groupByUploader: Boolean
  maxFileSize: Int64
  maxTotalBytes: Int64
  maxFiles: Int
  expiresAt: Time
}

# 访客打开链接看到的信息。不含属主信息,也不含属主剩余空间。
type FileRequestInfo {
  title: String!
  note: String!
  needPassword: Boolean!
  needName: Boolean!
  maxFileSize: Int64
  expiresAt: Time
  # 已撤销、已截止或暂不可用
  closed: Boolean!
}

# 访客凭证:scope 只够往这条链接里传文件
type CollectAuth {
  accessToken: String!
}

# 访客视角的一个已送达文件
type CollectUpload {
  name: String!
  size: Int64!
  createdAt: Time!
}

# ---------- 后台任务(doc/21):离线下载、解压 ----------

enum JobKind { FETCH_URL, EXTRACT_ARCHIVE }
enum JobStatus { QUEUED, RUNNING, DONE, FAILED, CANCELED }

type Job {
  id: ID!
  kind: JobKind!
  status: JobStatus!
  # 列表上显示的名字:下载的文件名(拿到响应头之前是链接的主机名)/ 压缩包名
  title: String!
  # 离线下载的链接;解压任务为 null
  url: String
  # 目标文件夹;null = 根目录
  parentId: ID
  # 下好的文件 / 解出来的文件夹;没完成、或已经删掉时为 null
  result: Node
  bytesDone: Int64!
  # 未知(源站没给长度)为 null
  bytesTotal: Int64
  filesDone: Int!
  filesTotal: Int
  # 解压时跳过的条目(路径不安全、软链接、名字不合法)
  filesSkipped: Int!
  # 失败原因;成功但有提示时也有(GOT_HTML:拿到的是网页,不是文件)
  errorCode: String
  errorMessage: String
  attempts: Int!
  # 提交渠道:web / android / mcp
  source: String!
  createdAt: Time!
  startedAt: Time
  finishedAt: Time
}

type JobPage {
  items: [Job!]!
  nextCursor: String
}

# ---------- 压缩包(doc/21 四) ----------

enum ArchiveStatus { PENDING, DONE, TRUNCATED, UNSUPPORTED, FAILED }

type ArchiveInfo {
  # PENDING:还在读目录;TRUNCATED:条目太多或包太大,只列了一部分;UNSUPPORTED / FAILED 见 error
  status: ArchiveStatus!
  # zip / 7z / rar / tar / tar.gz / tar.bz2 / tar.xz
  format: String!
  entryCount: Int!
  fileCount: Int!
  # 解压后总大小(按条目声明)
  totalSize: Int64!
  solid: Boolean!
  encrypted: Boolean!
  error: String
}

type ArchiveEntry {
  # 包内行号:单个文件的地址是 /arc/{nodeId}/{idx}?token=<access>(加 &download=1 为下载)
  idx: Int!
  path: String!
  name: String!
  isDir: Boolean!
  size: Int64!
  modifiedAt: Time
  # 非空时不能预览、不能解压:encrypted / unsafe(路径带 ..)/ link / unsupported
  flag: String
  # 能直接预览(图片、PDF、文本,且大小与在包里的深度都在限度内)
  previewable: Boolean!
  # 能单独下载(大小与深度在限度内)
  downloadable: Boolean!
}

type ArchiveEntryPage {
  items: [ArchiveEntry!]!
  nextCursor: String
  total: Int!
}

# ---------- 文件传输助手(我的设备) ----------

type ChatMessage {
  id: ID!
  body: String!
  createdAt: Time!
  # 写入渠道:web / mcp / webdav。只做展示
  source: String!
  # 附件节点;无附件时为 null。节点被删/彻删后仍为消息,此字段返回 null。
  node: Node
}

# ---------- 查询 ----------

enum NodeOrder { NAME, SIZE, UPDATED_AT }

type Query {
  mcpAccessRoots: [MCPAccessRoot!]!
  mcpAudit(beforeId: Int64 = 0, limit: Int = 50): [MCPAuditEvent!]!
  me: User!
  # 登录设备列表,最近活跃的在前
  sessions: [Session!]!
  node(id: ID!): Node!
  children(parentId: ID, cursor: String, order: NodeOrder = NAME, desc: Boolean = false): NodePage!
  searchNodes(q: String!, cursor: String): NodePage!
  # 按内容搜索:关键词至少两个汉字或三个字母(QUERY_TOO_SHORT);本站关了内容索引则 CONTENT_SEARCH_DISABLED
  searchContent(q: String!, cursor: String): ContentHitPage!
  trash(cursor: String): NodePage!
  myShares: [Share!]!
  # 某个分享最近的访问明细,只允许属主看
  shareVisits(shareId: ID!, limit: Int = 50): [ShareVisit!]!
  uploadSession(id: ID!): UploadSession!
  shareInfo(token: String!): ShareInfo!
  shareRoot: Node!

  # 收集文件:属主侧
  myFileRequests: [FileRequest!]!
  fileRequestUploads(id: ID!, cursor: String): FileRequestUploadPage!
  # 收集文件:公开 / 访客侧
  fileRequestInfo(token: String!): FileRequestInfo!
  collectUploadSession(id: ID!): UploadSession!
  collectMyUploads: [CollectUpload!]!

  appPasswords: [AppPassword!]!
  mcpAPIKeys: [MCPAPIKey!]!
  oauthGrants: [OAuthGrant!]!
  oauthAuthorizationRequest(input: OAuthAuthorizationInput!): OAuthAuthorizationRequest!

  # 传输助手:最近 limit 条消息,升序(旧→新)。单用户单会话。
  # before:消息 id 游标,只取比它更旧的(从锚点往前数 limit 条);after:只取比它更新的(从锚点往后数 limit 条);
  # 两者互斥(同时给 INVALID_INPUT)。query:正文或附件名包含关键词(此时忽略游标,取最新 limit 条命中后升序返回)。
  chatMessages(limit: Int = 200, before: ID, after: ID, query: String): [ChatMessage!]!
  # 当前"我的设备"文件夹;从未创建过返回 null,不触发创建。
  chatFolder: Node

  # 压缩包概要;还没读完目录时 status = PENDING。分享访客在分享范围内可用
  archiveInfo(nodeId: ID!): ArchiveInfo!
  # 压缩包里某个目录(path 为空即根目录)的条目,目录在前、按名字
  archiveEntries(nodeId: ID!, path: String, cursor: String): ArchiveEntryPage!
  # 后台任务(离线下载、解压),新的在前;active 只列排队与进行中的
  myJobs(active: Boolean = false, cursor: String): JobPage!
  job(id: ID!): Job!
  # 本站是否开了离线下载(GOPAN_FETCH)
  fetchEnabled: Boolean!

  adminUsers: [AdminUser!]!
  adminOverview: AdminOverview!
}

# ---------- 变更 ----------

input PartEtag {
  partNumber: Int!
  etag: String!
}

input OAuthAuthorizationInput {
  clientId: String!
  redirectUri: String!
  responseType: String!
  scope: String
  state: String
  codeChallenge: String!
  codeChallengeMethod: String!
}

type Mutation {
  setMCPAccessRoot(credentialId: ID!, credentialType: String!, rootPath: String): Boolean!
  register(username: String!, password: String!): AuthPayload!
  login(username: String!, password: String!): AuthPayload!
  refresh: AuthPayload!
  logout: Boolean!

  changePassword(oldPassword: String!, newPassword: String!): AuthPayload!
  # 吊销一个登录设备。不能吊销当前会话 —— 那是 logout 该干的事。
  revokeSession(familyId: ID!): Boolean!

  createFolder(parentId: ID, name: String!): Node!
  renameNode(id: ID!, name: String!): Node!
  moveNodes(ids: [ID!]!, targetParentId: ID): [Node!]!
  copyNodes(ids: [ID!]!, targetParentId: ID): [Node!]!
  deleteNodes(ids: [ID!]!): Boolean!
  restoreNodes(ids: [ID!]!): [Node!]!
  purgeNodes(ids: [ID!]!): Boolean!
  purgeTrash: Boolean!

  initUpload(parentId: ID, name: String!, sha256: String!, size: Int64!): UploadInit!
  completeUpload(sessionId: ID!, etags: [PartEtag!]!): Node!
  abortUpload(sessionId: ID!): Boolean!

  requestPreview(nodeId: ID!): PreviewInfo!

  createShare(nodeId: ID!, password: String, expiresAt: Time): Share!
  revokeShare(id: ID!): Boolean!
  verifySharePassword(token: String!, password: String!): ShareAuth!

  # 收集文件:属主侧
  createFileRequest(folderId: ID!, input: FileRequestInput!, password: String): FileRequest!
  updateFileRequest(id: ID!, input: FileRequestInput!): FileRequest!
  revokeFileRequest(id: ID!): Boolean!
  markFileRequestSeen(id: ID!): Boolean!
  # 收集文件:访客侧。openFileRequest 公开;其余要 openFileRequest 发的令牌。
  # 上传协议与 initUpload / completeUpload 相同,只是不传 sha256、没有秒传,complete 不返回节点。
  openFileRequest(token: String!, password: String, uploaderName: String): CollectAuth!
  collectInitUpload(name: String!, size: Int64!): UploadSession!
  collectCompleteUpload(sessionId: ID!, etags: [PartEtag!]!): CollectUpload!
  collectAbortUpload(sessionId: ID!): Boolean!

  # WebDAV 应用密码:明文只在返回值出现一次
  createAppPassword(name: String!): String!
  revokeAppPassword(id: ID!): Boolean!

  createMCPAPIKey(name: String!, scopes: [String!]!): MCPAPIKeyCreated!
  revokeMCPAPIKey(id: ID!): Boolean!
  decideOAuthAuthorization(input: OAuthAuthorizationInput!, approved: Boolean!): OAuthAuthorizationResult!
  revokeOAuthGrant(id: ID!): Boolean!

  # 传输助手:body / nodeId 至少其一;nodeId 必须是当前用户的活跃节点。同一节点已在会话中则返回已有消息(幂等)。
  sendChatMessage(body: String, nodeId: ID): ChatMessage!
  # 删除一条消息(只删消息,不动附件文件)。不存在/非本人 → NOT_FOUND。
  deleteChatMessage(id: ID!): Boolean!
  # 幂等返回"我的设备"文件夹(首次调用才创建)。
  ensureChatFolder: Node!

  # 离线下载:每条链接一个任务,存到 parentId(null = 根目录)。一次最多 10 条,每人排队 + 进行中最多 10 个
  fetchUrls(urls: [String!]!, parentId: ID): [Job!]!
  # 解压:paths(包内完整路径)为空即 base 下的全部,解出的路径相对 base;
  # 解到 parentId 下的新文件夹(以压缩包名命名,撞名改名;null = 根目录)。后台执行,返回任务
  extractArchive(nodeId: ID!, base: String, paths: [String!], parentId: ID): Job!
  # 取消排队或进行中的任务(进行中的会停下并清掉已下载的部分)
  cancelJob(id: ID!): Job!
  # 失败或已取消的任务重新排队
  retryJob(id: ID!): Job!
  # 清掉已结束的任务记录(不动下好的文件),返回清掉的条数
  clearFinishedJobs: Int!

  adminCreateUser(username: String!, password: String!, quotaBytes: Int64): AdminUser!
  adminSetQuota(userId: ID!, quotaBytes: Int64!): AdminUser!
  adminSetDisabled(userId: ID!, disabled: Boolean!): AdminUser!
  # 生成随机新密码并吊销该用户全部会话;明文只在返回值出现一次
  adminResetPassword(userId: ID!): String!
  adminRetryFailedTasks: Int!
}

type MCPAccessRoot { credentialId: ID!, credentialType: String!, rootId: ID!, rootName: String! }
type MCPAuditEvent { id: Int64!, credentialId: ID!, credentialType: String!, endpoint: String!, tool: String!, status: String!, errorCode: String, createdAt: Time! }

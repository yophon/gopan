scalar Time
scalar Int64

# ---------- 对象 ----------

type User {
  id: ID!
  username: String!
  quotaBytes: Int64!
  usedBytes: Int64!
  isAdmin: Boolean!
  # 未读通知数(doc/22 三);网页随 30 秒一次的 me 轮询带回
  unreadNotifications: Int!
}

# 一个登录设备(按 refresh token family 分组)。
type Session {
  familyId: ID!
  # 原始 UA(服务端截断到 512 字节),展示时由前端归类成"Chrome · Windows"这种
  userAgent: String!
  ip: String!
  createdAt: Time!
  lastSeenAt: Time!
  # 被吊销的时刻:改密、管理员禁用、重放检测触发整族吊销
  revokedAt: Time
  # 这族 refresh token 还能不能用
  active: Boolean!
  # 是不是当前这个请求所在的会话(access token 里的 fid)
  current: Boolean!
}

# ---------- WebDAV 应用密码 ----------

type AppPassword {
  id: ID!
  name: String!
  createdAt: Time!
  lastUsedAt: Time
}

type MCPAPIKey {
  id: ID!
  name: String!
  scopes: [String!]!
  createdAt: Time!
  lastUsedAt: Time
}

type MCPAPIKeyCreated {
  token: String!
  credential: MCPAPIKey!
}

type OAuthGrant {
  id: ID!
  clientId: String!
  clientName: String!
  scopes: [String!]!
  createdAt: Time!
  updatedAt: Time!
}

type OAuthAuthorizationRequest {
  clientName: String!
  scopes: [String!]!
}

type OAuthAuthorizationResult {
  redirectUrl: String!
}

# ---------- 管理端(所有 admin* 字段要求调用者 is_admin,校验在 service 层) ----------

type AdminUser {
  id: ID!
  username: String!
  isAdmin: Boolean!
  disabled: Boolean!
  quotaBytes: Int64!
  usedBytes: Int64!
  # 今天经站点提供的模型服务用掉的 token(doc/33)
  aiTokensToday: Int64!
  createdAt: Time!
}

type TaskCount {
  status: String!
  count: Int!
}

type AdminOverview {
  userCount: Int!
  totalUsedBytes: Int64!
  blobCount: Int!
  blobBytes: Int64!
  taskCounts: [TaskCount!]!
  contentIndex: ContentIndexStats!
}

# 内容搜索的索引进度(doc/20)。按内容(blob)计,同一份内容多个文件共享一份。
type ContentIndexStats {
  # GOPAN_CONTENT_INDEX 关掉时为 false,其余数字照旧给出
  enabled: Boolean!
  done: Int!
  # 支持的格式但没有文字(扫描件、空文档)
  empty: Int!
  # 文字太长只收了前一部分
  truncated: Int!
  unsupported: Int!
  failed: Int!
  # 还没提过或提取器版本旧了,等着排队的
  pending: Int!
  textBytes: Int64!
}

enum NodeKind { FILE, FOLDER }

type Node {
  id: ID!
  parentId: ID
  name: String!
  kind: NodeKind!
  size: Int64
  mime: String
  sha256: String
  createdAt: Time!
  updatedAt: Time!
  deletedAt: Time
  # 回收站里的节点:预计被彻删的时刻(deleted_at + GOPAN_TRASH_TTL)。
  # 只有 trash 查询会填,其它路径一律 null —— 让前端不必知道运维配的保留期是多少。
  purgeAt: Time
  preview: PreviewInfo!
  downloadUrl: String
  # 音视频给外部播放器的内联地址,12 小时有效(桌面端「用播放器播放」,doc/31 三);只给登录用户,别的文件为空
  streamUrl: String
  # 子树统计(仅文件夹;异步重算,statsStale=true 表示数字可能滞后)
  subtreeBytes: Int64
  subtreeCount: Int64
  statsStale: Boolean
  # 播放进度(doc/22 二.3):音视频、PDF;没记过、访客、文件夹为 null。每个节点一次查询,只在单个节点上取,列表里别请求
  playProgress: PlayProgress
  # 从根开始的路径,如 /工作资料/合同/报价.pdf;访客与回收站里的节点为 null。
  # 每个节点一次递归查询:搜索结果这类要显示「位置」的地方取,普通列表别请求
  path: String
  # 收藏(doc/24);分享访客看到的一律是 false
  starred: Boolean!
  # 最后一次在网页 / App 里打开(预览、播放、下载)的时刻;没打开过、访客为 null
  openedAt: Time
}

# 历史版本(doc/24):文件被同名覆盖时留下的旧内容
type FileVersion {
  id: ID!
  size: Int64!
  sha256: String!
  mime: String!
  # 这份内容当初写进来的时刻
  savedAt: Time!
  # 被换下来的时刻;过了保留期(keepDays 天)自动清理
  replacedAt: Time!
  # 预签名下载地址(15 分钟有效),文件名是文件现在的名字
  downloadUrl: String!
}

# 在线编辑(doc/25):整份文本 + 打开时的 sha256(保存时带回去做冲突检查)
type TextFile {
  content: String!
  sha256: String!
  size: Int64!
}

type FileVersionList {
  items: [FileVersion!]!
  # 本站的保留策略:每个文件最多留几个(0 = 覆盖时不留旧版本),换下来后留几天
  keep: Int!
  keepDays: Int!
}

# ARCHIVE:压缩包(zip / 7z / rar / tar.*),用 archiveInfo / archiveEntries 浏览
enum PreviewKind { NONE, IMAGE, PDF, NATIVE_PDF, VIDEO, AUDIO, TEXT, OFFICE, ARCHIVE }

type PreviewInfo {
  kind: PreviewKind!
  thumbUrl: String
  largeUrl: String
  contentUrl: String
  status: TaskStatus
  durationSec: Int
  # 外挂字幕(doc/22 二.2):只有 VIDEO 在 node(id) / requestPreview 里给出,列表里恒为空
  subtitles: [SubtitleTrack!]!
  # .md 且不超过 2 MB:能渲染着看,GET /md/{nodeId}?token=<access>[&theme=light|dark](doc/23 五.2)。
  # kind 仍是 TEXT,老客户端照旧按文本显示
  markdown: Boolean!
  # 浏览器放不了的视频容器(mkv / avi / ts / flv …)在服务器上转成 mp4 的状态(doc/31 一)。
  # 只在 node(id) 详情里给;别的视频、或本站没开转换时为空。安卓 App 自己能放这些格式,不用看它
  remux: RemuxInfo
}

type RemuxInfo {
  status: RemuxStatus!
  # RUNNING 时 0~1
  progress: Float
  # DONE 时的 mp4 地址(站内路径,6 小时内有效;过期了重新查 node 拿新的)
  url: String
  # 浏览器多半能直接放原文件(mkv 里是 H.264 + AAC 等、没有内嵌字幕):先放 contentUrl,放不了再 requestRemux
  direct: Boolean!
  # UNSUPPORTED / FAILED / UNAVAILABLE 时给人看的原因
  message: String
  # DONE 时文件里内嵌的文字字幕,已转成 WebVTT;同文件夹的外挂字幕仍在 PreviewInfo.subtitles
  subtitles: [EmbeddedSubtitle!]!
}

enum RemuxStatus { NONE, QUEUED, RUNNING, DONE, UNSUPPORTED, FAILED, UNAVAILABLE }

type EmbeddedSubtitle {
  label: String!
  lang: String!
  url: String!
  default: Boolean!
}

# 同文件夹里与视频同名的字幕文件。内容一律转成 WebVTT:GET /sub/{nodeId}?token=<access>
# (也接受 Authorization 头;分享访客在分享范围内可用)
type SubtitleTrack {
  nodeId: ID!
  name: String!
  # 显示名:简体中文 / 繁体中文 / English / 日本語 …;认不出时是文件名里的标记或「字幕」
  label: String!
  # BCP 47:zh-Hans / zh-Hant / zh / en / ja / ko …;认不出为空串
  lang: String!
  # 默认选中的一条(中文优先,其次第一条)
  default: Boolean!
}

# ---------- 影音(doc/22 二) ----------

type PlayProgress {
  # 音视频是秒;PDF 是页码(从 1 开始)
  position: Float!
  # 音视频是总秒数;PDF 是总页数
  duration: Float!
  # 看完了(剩余不到 3% 或不到 20 秒,PDF 翻到最后一页):下次从头开始
  finished: Boolean!
  updatedAt: Time!
}

type RecentPlay {
  node: Node!
  progress: PlayProgress!
}

# ---------- 通知(doc/22 三) ----------

enum NotificationLevel { INFO, WARN, ALERT }

# 点开通知跳到哪。NODE:id 是文件 / 文件夹,parentId 是所在文件夹(null = 根目录);
# FILE_REQUEST / LINK:id 是收集链接 / 直链;JOBS:后台任务列表;SESSIONS:登录设备;CREDENTIALS:新建的凭据,id 是 webdav(应用密码)/ mcp(API Key、Agent 授权)/ img(图床密钥);ADMIN:管理端
enum NotificationTargetKind { NODE, FILE_REQUEST, LINK, JOBS, SESSIONS, CREDENTIALS, ADMIN, ACTIVITY, FEED, ASSISTANT }

type NotificationTarget {
  kind: NotificationTargetKind!
  id: ID
  parentId: ID
}

type Notification {
  id: ID!
  # 事件类型,见 notifyEventKinds
  kind: String!
  level: NotificationLevel!
  title: String!
  body: String!
  # 同一件事 30 分钟内重复发生时合并,这里是合并了几次
  count: Int!
  target: NotificationTarget
  createdAt: Time!
  # 最后一次合并的时刻;没合并过等于 createdAt
  updatedAt: Time!
  read: Boolean!
}

type NotificationPage {
  items: [Notification!]!
  nextCursor: String
}

# 事件类型:collect_upload / collect_full / job_done / job_failed / quota / login / credential / link_alert / backup
type NotifyEventKind {
  kind: String!
  label: String!
  # 新建渠道时默认勾上
  defaultPush: Boolean!
  # 只发给管理员(备份)
  adminOnly: Boolean!
}

enum NotifyChannelKind { WEBHOOK, NTFY, BARK, TELEGRAM }

# 推送渠道。密钥类字段只写不读:webhook 的签名密钥、ntfy 的访问令牌、bark 的 device key、telegram 的 bot token
type NotifyChannel {
  id: ID!
  kind: NotifyChannelKind!
  name: String!
  enabled: Boolean!
  # 推哪些事件(NotifyEventKind.kind)
  events: [String!]!
  # webhook:地址;ntfy / bark:服务器;telegram:不用
  url: String!
  # ntfy:topic;telegram:chat id;其余不用
  topic: String!
  hasSecret: Boolean!
  # 密钥末 4 位,没有为空串
  secretHint: String!
  lastOkAt: Time
  lastError: String
  lastErrorAt: Time
  createdAt: Time!
}

# 整表单提交。secret 不传 = 保持原值(新建时即没有);传空串 = 清除
input NotifyChannelInput {
  kind: NotifyChannelKind!
  name: String!
  enabled: Boolean!
  events: [String!]!
  url: String
  topic: String
  secret: String
}

# ---------- 直链与图床(doc/22 四) ----------

# PAUSED:手动暂停或超了每天的流量上限(见 pauseReason);EXPIRED:过了有效期;
# UNAVAILABLE:文件在回收站、属主被禁用,或全站本月流量用完 / 管理员关了直链
enum LinkStatus { ACTIVE, PAUSED, EXPIRED, UNAVAILABLE }

type LinkUsage {
  hits: Int64!
  bytes: Int64!
  # 被来源白名单、限流、上限拦下的次数
  blocked: Int64!
}

type DirectLink {
  id: ID!
  token: String!
  # 站内路径 /x/<token>/<当前文件名>,前面拼上站点地址即直链
  path: String!
  # 完整地址(GOPAN_PUBLIC_URL + path);没配站点地址时与 path 相同
  url: String!
  nodeId: ID!
  name: String!
  mime: String
  size: Int64
  status: LinkStatus!
  # manual(手动)/ daily_cap(超了当天上限,次日自动恢复)/ anomaly(异常时自动暂停)
  pauseReason: String
  # web / android / api(图床接口)/ mcp
  source: String!
  createdAt: Time!
  expiresAt: Time
  # 来源白名单;null = 用默认规则(linkPrefs)
  refererHosts: [String!]
  # 允许没有来源的访问(直接打开、App 里看);null = 用默认规则
  allowNoReferer: Boolean
  # 每天的流量上限;null = 用全站默认(linkPrefs.dailyBytesCapDefault)
  dailyBytesCap: Int64
  # 检测到异常时自动暂停(默认只提醒)
  autoPause: Boolean!
  # JPEG 里带拍摄位置(生成直链时检测)
  hasGps: Boolean!
  hitsTotal: Int64!
  bytesTotal: Int64!
  lastHitAt: Time
  # 今天(按 GOPAN_TZ)与近 30 天
  today: LinkUsage!
  last30Days: LinkUsage!
}

type DirectLinkPage {
  items: [DirectLink!]!
  nextCursor: String
  total: Int!
}

type LinkHourStat {
  hour: Time!
  hits: Int64!
  bytes: Int64!
  blocked: Int64!
  # 独立 IP 数(按小时)
  ips: Int!
}

type LinkReferer {
  # 来源站点;没有来源为空串,超出的合在「其他」(host = "*")
  host: String!
  hits: Int64!
  bytes: Int64!
}

# 访问明细(每条直链每小时最多记 200 条,超出只计数)
type LinkHit {
  at: Time!
  ip: String!
  userAgent: String!
  referer: String!
  status: Int!
  bytes: Int64!
}

type LinkHitPage {
  items: [LinkHit!]!
  nextCursor: String
}

# 每人一份的默认规则,以及全站的上限与本月用量(只读)
type LinkPrefs {
  refererHosts: [String!]!
  allowNoReferer: Boolean!
  # 图床接口与网页粘贴上传存到这里(按「年-月」分子文件夹,按需创建)
  imageFolder: String!
  # 图床上传时抹掉 JPEG 的 GPS 位置
  stripGps: Boolean!
  dailyBytesCapDefault: Int64!
  monthlyBytesCap: Int64!
  # 全站本月直链流量
  monthlyBytesUsed: Int64!
}

input LinkPrefsInput {
  refererHosts: [String!]!
  allowNoReferer: Boolean!
  # 网盘里的路径,如 /图床
  imageFolder: String!
  stripGps: Boolean!
}

# 整表单提交:refererHosts / allowNoReferer / dailyBytesCap 为 null = 用默认,expiresAt 为 null = 永久
input DirectLinkInput {
  refererHosts: [String!]
  allowNoReferer: Boolean
  dailyBytesCap: Int64
  expiresAt: Time
  autoPause: Boolean!
}

type AdminLink {
  id: ID!
  owner: String!
  name: String!
  path: String!
  status: LinkStatus!
  monthHits: Int64!
  monthBytes: Int64!
}

type AdminLinkStats {
  monthHits: Int64!
  monthBytes: Int64!
  monthlyBytesCap: Int64!
  # 本月流量前 10
  top: [AdminLink!]!
}

# UNAVAILABLE:该派生能力未在本次部署中启用(如未部署 Gotenberg 时的 Office 转换)
enum TaskStatus { PENDING, RUNNING, DONE, FAILED, UNAVAILABLE }

type NodePage {
  items: [Node!]!
  nextCursor: String
  total: Int!
}

# 内容搜索的一条结果(doc/20 第三节)
type ContentHit {
  node: Node!
  # 第一处命中前后的一段原文,两头被截时带"…"
  snippet: String!
  # 片段里每处命中的位置(按字符)
  highlights: [TextRange!]!
  # 命中所在页(PDF / 由 Office 转出的 PDF);其余格式为 null
  page: Int
}

type TextRange {
  start: Int!
  length: Int!
}

# 不返回 total:要把所有候选都复核一遍才数得出来,代价高
type ContentHitPage {
  items: [ContentHit!]!
  nextCursor: String
}

type UploadInit {
  instant: Boolean!
  node: Node
  session: UploadSession
}

type UploadSession {
  id: ID!
  partSize: Int!
  partUrls: [PartUrl!]!
  uploadedParts: [Int!]!
  expiresAt: Time!
  status: String!
}

type PartUrl {
  partNumber: Int!
  url: String!
}

type Share {
  id: ID!
  token: String!
  node: Node!
  hasPassword: Boolean!
  # 访客能往里传文件、建文件夹(只有文件夹分享会是 true,doc/32 一)
  allowUpload: Boolean!
  expiresAt: Time
  createdAt: Time!
  # 访问统计。没有访问时返回全零对象(非空,前端不用判空)。
  visitStats: ShareVisitStats!
}

# 一条分享访问记录。
type ShareVisit {
  # verify(访客进入)/ download(单文件下载)/ pack(打包下载)/ upload(访客传了文件)
  kind: String!
  ip: String
  userAgent: String
  # upload 时是「访客留的名字 · 文件名」
  detail: String
  createdAt: Time!
}

# 分享的访问汇总。
#
# 计数是**近 180 天**的:worker 会清理更早的记录,别当成历史总量。
# downloadCount 的语义是"发起了下载"(下载走预签名直连对象存储,服务端观测不到
# 完成时刻),单文件下载与打包合计在这里。
type ShareVisitStats {
  verifyCount: Int64!
  downloadCount: Int64!
  uploadCount: Int64!
  lastVisitAt: Time
  lastVisitKind: String
}

type ShareInfo {
  token: String!
  name: String!
  kind: NodeKind!
  needPassword: Boolean!
  expired: Boolean!
  # 访客能上传(doc/32 一)
  allowUpload: Boolean!
  # 访客页头部显示(v3.8):有密码的分享在验密前一律为 null,不提前透露内容的规模
  expiresAt: Time
  # 文件是大小;文件夹是子树体积与文件数(异步统计,可能略滞后)
  size: Int64
  fileCount: Int64
}

type AuthPayload {
  accessToken: String!
  user: User!
}

# 访客凭证:不返回 User,避免向访客泄露属主信息
type ShareAuth {
  accessToken: String!
}

# ---------- 收集文件(doc/20):对文件夹开链接,访客不登录往里传,只写不读 ----------

type FileRequest {
  id: ID!
  token: String!
  folder: Node!
  title: String!
  note: String!
  hasPassword: Boolean!
  requireName: Boolean!
  groupByUploader: Boolean!
  # 上限,null = 不限
  maxFileSize: Int64
  maxTotalBytes: Int64
  maxFiles: Int
  expiresAt: Time
  createdAt: Time!
  # 收件统计(按收件记录算,文件删了也算)
  fileCount: Int!
  totalBytes: Int64!
  uploaderCount: Int!
  # 属主上次查看收件记录之后新收到的个数
  newCount: Int!
  lastUploadAt: Time
}

type FileRequestUpload {
  id: ID!
  fileName: String!
  size: Int64!
  # 访客自填,可能为空
  uploaderName: String!
  ip: String
  userAgent: String
  createdAt: Time!
  # 文件还在时给出节点;进了回收站或彻删后为 null
  node: Node
}

type FileRequestUploadPage {
  items: [FileRequestUpload!]!
  nextCursor: String
}

# 整表单提交:没给的上限 = 不限。密码与目标文件夹创建后不能改。
input FileRequestInput {
  title: String!
  note: String
  requireName: Boolean
  groupByUploader: Boolean
  maxFileSize: Int64
  maxTotalBytes: Int64
  maxFiles: Int
  expiresAt: Time
}

# 访客打开链接看到的信息。不含属主信息,也不含属主剩余空间。
type FileRequestInfo {
  title: String!
  note: String!
  needPassword: Boolean!
  needName: Boolean!
  maxFileSize: Int64
  expiresAt: Time
  # 已撤销、已截止或暂不可用
  closed: Boolean!
}

# 访客凭证:scope 只够往这条链接里传文件
type CollectAuth {
  accessToken: String!
}

# 访客视角的一个已送达文件
type CollectUpload {
  name: String!
  size: Int64!
  createdAt: Time!
}

# ---------- 后台任务(doc/21):离线下载、解压 ----------

enum JobKind { FETCH_URL, EXTRACT_ARCHIVE, CLIP_URL }
enum JobStatus { QUEUED, RUNNING, DONE, FAILED, CANCELED }

type Job {
  id: ID!
  kind: JobKind!
  status: JobStatus!
  # 列表上显示的名字:下载的文件名(拿到响应头之前是链接的主机名)/ 压缩包名
  title: String!
  # 离线下载的链接;解压任务为 null
  url: String
  # 目标文件夹;null = 根目录
  parentId: ID
  # 下好的文件 / 解出来的文件夹;没完成、或已经删掉时为 null
  result: Node
  bytesDone: Int64!
  # 未知(源站没给长度)为 null
  bytesTotal: Int64
  filesDone: Int!
  filesTotal: Int
  # 解压时跳过的条目(路径不安全、软链接、名字不合法)
  filesSkipped: Int!
  # 失败原因;成功但有提示时也有(GOT_HTML:拿到的是网页,不是文件)
  errorCode: String
  errorMessage: String
  attempts: Int!
  # 提交渠道:web / android / mcp
  source: String!
  createdAt: Time!
  startedAt: Time
  finishedAt: Time
}

type JobPage {
  items: [Job!]!
  nextCursor: String
}

# ---------- 压缩包(doc/21 四) ----------

enum ArchiveStatus { PENDING, DONE, TRUNCATED, UNSUPPORTED, FAILED }

type ArchiveInfo {
  # PENDING:还在读目录;TRUNCATED:条目太多或包太大,只列了一部分;UNSUPPORTED / FAILED 见 error
  status: ArchiveStatus!
  # zip / 7z / rar / tar / tar.gz / tar.bz2 / tar.xz
  format: String!
  entryCount: Int!
  fileCount: Int!
  # 解压后总大小(按条目声明)
  totalSize: Int64!
  solid: Boolean!
  encrypted: Boolean!
  error: String
}

type ArchiveEntry {
  # 包内行号:单个文件的地址是 /arc/{nodeId}/{idx}?token=<access>(加 &download=1 为下载)
  idx: Int!
  path: String!
  name: String!
  isDir: Boolean!
  size: Int64!
  modifiedAt: Time
  # 非空时不能预览、不能解压:encrypted / unsafe(路径带 ..)/ link / unsupported
  flag: String
  # 能直接预览(图片、PDF、文本,且大小与在包里的深度都在限度内)
  previewable: Boolean!
  # 能单独下载(大小与深度在限度内)
  downloadable: Boolean!
}

type ArchiveEntryPage {
  items: [ArchiveEntry!]!
  nextCursor: String
  total: Int!
}

# ---------- 文件传输助手(我的设备) ----------

type ChatMessage {
  id: ID!
  body: String!
  createdAt: Time!
  # 写入渠道:web / mcp / webdav。只做展示
  source: String!
  # 附件节点;无附件时为 null。节点被删/彻删后仍为消息,此字段返回 null。
  node: Node
}

# ---------- 动态与撤回(doc/23 二) ----------

enum ActorKind { WEB, ANDROID, WEBDAV, AGENT, ASSISTANT, IMG, COLLECT, SHARE, JOB, FEED, CLIP, SYSTEM }
enum ActivityAction { MKDIR, UPLOAD, OVERWRITE, RENAME, MOVE, COPY, DELETE, RESTORE, PURGE, EXTRACT }

type ActivityActor {
  kind: ActorKind!
  # 来源的标识:登录会话 / 应用密码 / 凭据(api_key:… / oauth:…)/ 图床密钥 / 收集链接 / 任务 / 订阅的 id;系统为空
  ref: String!
  # 当时的名字快照:设备名、应用密码名、Key 名、收集链接标题 · 访客名……
  label: String!
}

type Activity {
  id: ID!
  at: Time!
  actor: ActivityActor!
  # 同一次操作共用:一次多选移动、一次 Agent 工具调用、一个后台任务、一次撤回
  batchId: ID!
  action: ActivityAction!
  # 节点彻底删除后 id 仍在;node 只在节点还在网盘里(不在回收站)时给出
  nodeId: ID
  node: Node
  nodeKind: NodeKind
  name: String!
  # 当时所在的文件夹(移动的话是移动后的)
  parentPath: String!
  # 移动:从哪到哪
  fromPath: String
  toPath: String
  # 改名(以及还原时撞名改了名):前后的名字
  oldName: String
  newName: String
  # 涉及的文件数与字节(删除 / 复制 / 解压是整棵子树)
  files: Int64!
  bytes: Int64!
  # 补充说明:解压的是哪个包等
  note: String
  # 这条是对哪条的撤回
  undoOf: ID
  undoneAt: Time
  # 这类操作原则上能撤回(覆盖、彻底删除、已撤回过的为 false);现在能不能真撤看 undoPreview
  undoable: Boolean!
}

type ActivityPage {
  items: [Activity!]!
  nextCursor: String
}

type ActivityActorSummary {
  actor: ActivityActor!
  total: Int64!
  lastAt: Time!
}

input ActivityFilter {
  actorKind: ActorKind
  actorRef: String
  actions: [ActivityAction!]
  nodeId: ID
  batchId: ID
  since: Time
  until: Time
}

# 三选一:ids(最多 1000)、batchId、filter(至少给来源、时间或文件;最多撤最近的 1000 条)
# 批量改名的一项
input RenameItem {
  id: ID!
  name: String!
}

input UndoSelection {
  ids: [ID!]
  batchId: ID
  filter: ActivityFilter
}

type UndoItem {
  activity: Activity!
  ok: Boolean!
  # 撤不了的原因
  reason: String
}

type UndoResult {
  done: Int!
  failed: Int!
  # 从新到旧
  items: [UndoItem!]!
}

# ---------- 空间分析(doc/23 三) ----------

enum FileCategory { IMAGE, VIDEO, AUDIO, DOCUMENT, ARCHIVE, TEXT, OTHER }

# 搜索筛选(doc/30)。类型的划分与空间分析相同(FileCategory),FOLDER 是文件夹
enum SearchType { FOLDER, IMAGE, VIDEO, AUDIO, DOCUMENT, ARCHIVE, TEXT, OTHER }
enum SearchOrder { UPDATED, NAME, SIZE }

input SearchFilter {
  # 多选,空 = 不限
  types: [SearchType!]
  # 修改时间在 [modifiedAfter, modifiedBefore) 之间
  modifiedAfter: Time
  modifiedBefore: Time
  # 大小(字节,含两端);设了就只剩文件
  minSize: Int64
  maxSize: Int64
  # 只搜这个文件夹里的(含子文件夹)
  folderId: ID
  # 默认 UPDATED(最近修改的在前);NAME 按名字自然顺序;SIZE 大的在前。内容搜索只按修改时间
  order: SearchOrder
}

type SpaceCategory {
  category: FileCategory!
  files: Int64!
  bytes: Int64!
}

type SpaceOverview {
  usedBytes: Int64!
  quotaBytes: Int64!
  # 回收站里的(还占着配额,彻底删除或到期后才释放)
  trashFiles: Int64!
  trashBytes: Int64!
  byType: [SpaceCategory!]!
  # 重复文件:组数与删掉多余的能省下的配额(服务器上同一份内容本来只存一份)
  duplicateGroups: Int64!
  duplicateBytes: Int64!
  # 历史版本(doc/24):计入已用空间
  versionFiles: Int64!
  versionBytes: Int64!
}

type SpaceFolderLevel {
  # 这一层的路径(根为 /)
  path: String!
  # 子文件夹按子树大小从大到小(statsStale 表示数字可能滞后)
  folders: [Node!]!
  # 直接放在这一层的文件
  looseFiles: Int64!
  looseBytes: Int64!
}

type SpaceFile {
  node: Node!
  # 所在文件夹
  path: String!
  category: FileCategory
}

type DuplicateGroup {
  sha256: String!
  size: Int64!
  copies: Int!
  # 最早的在前(默认留它)
  files: [SpaceFile!]!
}

type DuplicatePage {
  items: [DuplicateGroup!]!
  # 还有下一页时给出下一页的 offset
  nextOffset: Int
}

type IdleShare {
  id: ID!
  # 分享链接是 /s/{token}
  token: String!
  nodeId: ID!
  name: String!
  kind: NodeKind!
  expiresAt: Time
  createdAt: Time!
  lastVisitAt: Time
  expired: Boolean!
}

type IdleLink {
  id: ID!
  nodeId: ID!
  name: String!
  expiresAt: Time
  createdAt: Time!
  lastHitAt: Time
  hits: Int64!
  expired: Boolean!
}

type IdleRequest {
  id: ID!
  title: String!
  folderId: ID!
  expiresAt: Time!
  createdAt: Time!
}

# 已过期的、或 90 天没人访问的分享与直链;已过期的收集链接
type SpaceIdle {
  shares: [IdleShare!]!
  links: [IdleLink!]!
  requests: [IdleRequest!]!
}

# 管理端:全站存储
type AdminStorage {
  # 各人用量加起来(同一份内容各算各的)
  logicalBytes: Int64!
  # 去重后实际存的
  physicalBytes: Int64!
  blobs: Int64!
  # 已经没人引用、等着回收的
  pendingGcBytes: Int64!
  # 缩略图、转换的 PDF、视频封面
  derivativeBytes: Int64!
  derivatives: Int64!
  # 正文索引与动态记录占的数据库空间
  textIndexBytes: Int64!
  activityBytes: Int64!
}

# ---------- 订阅(doc/23 四) ----------

enum FeedKind { RSS, GITHUB }
# DOWNLOAD 下载附件(播客音视频、GitHub 资源);CLIP 剪藏正文;NONE 只记录
enum FeedMode { DOWNLOAD, CLIP, NONE }
# NEW 记下了没处理(只记录、没附件);SKIPPED 被过滤或是订阅前的旧条目;QUEUED 等着或正在处理
enum FeedItemState { NEW, SKIPPED, QUEUED, DONE, FAILED }

type Feed {
  id: ID!
  kind: FeedKind!
  # RSS 地址;GitHub 为 owner/repo
  url: String!
  title: String!
  siteUrl: String!
  # 存到哪;被彻底删除后为 null(订阅已暂停)
  folder: Node
  # 存放文件夹的完整路径(如 /订阅/某播客);没有文件夹时为 null
  folderPath: String
  mode: FeedMode!
  # 标题关键词,逗号分隔:含任一 include(空 = 不限)且不含任何 exclude
  includeWords: String!
  excludeWords: String!
  # GitHub:资源文件名通配,如 *.apk, linux-amd64(空 = 全部)
  assetPattern: String!
  prerelease: Boolean!
  # 只留最近 N 条(更早的进回收站);0 = 不删
  keepLast: Int!
  intervalMinutes: Int!
  enabled: Boolean!
  lastCheckedAt: Time
  lastOkAt: Time
  lastError: String
  failCount: Int!
  nextCheckAt: Time!
  createdAt: Time!
  itemCount: Int!
  newCount: Int!
  latestAt: Time
}

type FeedItem {
  id: ID!
  title: String!
  # 原文链接
  url: String!
  enclosureUrl: String!
  enclosureType: String!
  enclosureSize: Int64
  publishedAt: Time
  state: FeedItemState!
  error: String
  # 下好 / 剪好的文件(进了回收站或被「只留最近 N 条」清掉后为 null)
  node: Node
  jobId: ID
  createdAt: Time!
}

type FeedItemPage {
  items: [FeedItem!]!
  nextCursor: String
}

type FeedPreviewItem {
  title: String!
  url: String!
  enclosureUrl: String!
  enclosureSize: Int64
  publishedAt: Time
}

type FeedPreview {
  kind: FeedKind!
  url: String!
  title: String!
  siteUrl: String!
  # 条目大多带音视频附件
  podcast: Boolean!
  suggestedMode: FeedMode!
  # 最近 10 条
  items: [FeedPreviewItem!]!
}

input FeedInput {
  # 新建时必填:RSS / Atom 地址,或 GitHub 仓库(owner/repo、github.com 链接);修改时忽略
  url: String
  title: String
  # 不给 = 新建时用 /订阅/<标题>,修改时不变
  folderId: ID
  mode: FeedMode
  includeWords: String
  excludeWords: String
  assetPattern: String
  prerelease: Boolean
  keepLast: Int
  # 60 – 10080,默认 360
  intervalMinutes: Int
  # 修改时用;新建总是开
  enabled: Boolean
  # 新建时:订阅前已有的条目里,处理最新的几条(其余标「已跳过」,可手动下载)
  initial: Int
}

type OpmlFailure {
  url: String!
  reason: String!
}

type OpmlImportResult {
  added: Int!
  existed: Int!
  failed: [OpmlFailure!]!
}

# ---------- 剪藏与 Markdown(doc/23 五) ----------

type Clip {
  id: ID!
  url: String!
  title: String!
  site: String!
  byline: String!
  excerpt: String!
  publishedAt: Time
  # 那篇 .md;阅读用 /md/{node.id}?token=<access>
  node: Node
  # 旁边存图片的「<标题>.assets」文件夹(删剪藏时一起删);没有图片或已不在时为 null
  assets: Node
  words: Int!
  images: Int!
  readAt: Time
  createdAt: Time!
}

type ClipPage {
  items: [Clip!]!
  nextCursor: String
}

type ClipSite {
  site: String!
  total: Int64!
}

# 剪过且没要求重新剪:existing 是已有的那篇;否则 job 是新建的剪藏任务
type ClipResult {
  job: Job
  existing: Clip
}

type ClipPrefs {
  # 剪藏文件夹,默认 /剪藏
  folder: String!
  # 按月分子文件夹(/剪藏/2026-10)
  byMonth: Boolean!
}

input ClipPrefsInput {
  folder: String!
  byMonth: Boolean!
}

# ---------- 查询 ----------

enum NodeOrder { NAME, SIZE, UPDATED_AT }

type Query {
  mcpAccessRoots: [MCPAccessRoot!]!
  mcpAudit(beforeId: Int64 = 0, limit: Int = 50): [MCPAuditEvent!]!
  me: User!
  # 登录设备列表,最近活跃的在前
  sessions: [Session!]!
  node(id: ID!): Node!
  # 按 id 一次查几个(助手回答里引用的文件,doc/35 六);查不到、没权限的直接不返回,最多 100 个
  nodesByIds(ids: [ID!]!): [Node!]!
  # 按网盘路径查(/笔记/会议.md);助手的引用有时写的是路径。查不到的不返回,最多 100 个
  nodesByPaths(paths: [String!]!): [Node!]!
  children(parentId: ID, cursor: String, order: NodeOrder = NAME, desc: Boolean = false): NodePage!
  # 按名字搜索。带 filter 时关键词可以为空(只按筛选找);分享访客的搜索忽略 filter
  searchNodes(q: String!, cursor: String, filter: SearchFilter): NodePage!
  # 按内容搜索:关键词至少两个汉字或三个字母(QUERY_TOO_SHORT);本站关了内容索引则 CONTENT_SEARCH_DISABLED
  searchContent(q: String!, cursor: String, filter: SearchFilter): ContentHitPage!
  trash(cursor: String): NodePage!
  myShares: [Share!]!
  # 某个分享最近的访问明细,只允许属主看
  shareVisits(shareId: ID!, limit: Int = 50): [ShareVisit!]!
  uploadSession(id: ID!): UploadSession!
  shareInfo(token: String!): ShareInfo!
  shareRoot: Node!

  # 收集文件:属主侧
  myFileRequests: [FileRequest!]!
  fileRequestUploads(id: ID!, cursor: String): FileRequestUploadPage!
  # 收集文件:公开 / 访客侧
  fileRequestInfo(token: String!): FileRequestInfo!
  collectUploadSession(id: ID!): UploadSession!
  collectMyUploads: [CollectUpload!]!
  # 分享访客的上传会话(断点续传),doc/32 一
  shareUploadSession(id: ID!): UploadSession!

  appPasswords: [AppPassword!]!
  mcpAPIKeys: [MCPAPIKey!]!
  oauthGrants: [OAuthGrant!]!
  oauthAuthorizationRequest(input: OAuthAuthorizationInput!): OAuthAuthorizationRequest!

  # 传输助手:最近 limit 条消息,升序(旧→新)。单用户单会话。
  # before:消息 id 游标,只取比它更旧的(从锚点往前数 limit 条);after:只取比它更新的(从锚点往后数 limit 条);
  # 两者互斥(同时给 INVALID_INPUT)。query:正文或附件名包含关键词(此时忽略游标,取最新 limit 条命中后升序返回)。
  chatMessages(limit: Int = 200, before: ID, after: ID, query: String): [ChatMessage!]!
  # 当前"我的设备"文件夹;从未创建过返回 null,不触发创建。
  chatFolder: Node

  # 压缩包概要;还没读完目录时 status = PENDING。分享访客在分享范围内可用
  archiveInfo(nodeId: ID!): ArchiveInfo!
  # 压缩包里某个目录(path 为空即根目录)的条目,目录在前、按名字
  archiveEntries(nodeId: ID!, path: String, cursor: String): ArchiveEntryPage!
  # 后台任务(离线下载、解压),新的在前;active 只列排队与进行中的
  myJobs(active: Boolean = false, cursor: String): JobPage!
  job(id: ID!): Job!
  # 本站是否开了离线下载(GOPAN_FETCH)
  fetchEnabled: Boolean!

  # 影音:同文件夹里同类(视频或音频)的文件,按自然顺序(第2集在第10集前),最多 1000 个,含 nodeId 本身。
  # 分享访客在分享范围内可用
  playlist(nodeId: ID!): [Node!]!
  # 没看完的,最近的在前
  recentPlays(limit: Int = 20): [RecentPlay!]!

  # 通知:新的在前
  notifications(cursor: String, unreadOnly: Boolean = false): NotificationPage!
  notifyChannels: [NotifyChannel!]!
  # 管理员能看到 adminOnly 的事件,其他人看不到
  notifyEventKinds: [NotifyEventKind!]!

  # 直链:新的在前
  myLinks(cursor: String): DirectLinkPage!
  link(id: ID!): DirectLink!
  # 某个文件当前有效的直链;没有为 null(不创建)
  nodeLink(nodeId: ID!): DirectLink
  # 按小时的统计,hours 最多 2160(90 天)
  linkStats(id: ID!, hours: Int = 168): [LinkHourStat!]!
  # 来源排行,days 最多 90
  linkReferers(id: ID!, days: Int = 30): [LinkReferer!]!
  linkHits(id: ID!, cursor: String): LinkHitPage!
  linkPrefs: LinkPrefs!
  # 本站是否开了直链(GOPAN_LINKS)
  linksEnabled: Boolean!
  adminLinkStats: AdminLinkStats!

  adminUsers: [AdminUser!]!
  adminOverview: AdminOverview!

  # 动态:新的在前;limit 最多 200
  activities(filter: ActivityFilter, cursor: String, limit: Int = 50): ActivityPage!
  # 近 90 天出现过的来源(筛选用),最近活跃的在前
  activityActors: [ActivityActorSummary!]!
  # 撤回前先看:会撤回哪些、哪些撤不了(不改任何东西)
  undoPreview(selection: UndoSelection!): UndoResult!

  # 收藏(doc/24):最近收藏的在前,最多 500 个;回收站里的不列
  starredNodes: [Node!]!
  # 最近打开的文件(doc/24):最近的在前,最多 500 个;每项的 playProgress 也一起给(列表里别处不给)
  recentFiles(limit: Int = 500): [Node!]!
  # 一个文件的历史版本,最近换下来的在前
  fileVersions(nodeId: ID!): FileVersionList!
  # 在线编辑:整份读出一个文本文件。超过 2 MB TOO_LARGE,不是 UTF-8 文本 NOT_TEXT
  textFile(nodeId: ID!): TextFile!

  # 空间分析:都是现算的只读查询
  spaceOverview: SpaceOverview!
  spaceFolders(parentId: ID): SpaceFolderLevel!
  spaceLargeFiles(category: FileCategory, limit: Int = 100): [SpaceFile!]!
  # 超过 days 天没改过、不小于 minSize 的文件
  spaceStaleFiles(days: Int = 365, minSize: Int64 = 104857600, limit: Int = 100): [SpaceFile!]!
  spaceDuplicates(offset: Int = 0, limit: Int = 50): DuplicatePage!
  # 子树里一个文件都没有的文件夹(只列最上面一层;收集链接、订阅、传输助手用着的不算)
  spaceEmptyFolders(limit: Int = 200): [SpaceFile!]!
  spaceIdle: SpaceIdle!
  adminStorage: AdminStorage!

  # 订阅
  feeds: [Feed!]!
  feed(id: ID!): Feed!
  feedItems(feedId: ID!, cursor: String): FeedItemPage!
  # 贴地址先看一眼(抓一次,不保存);assetPattern / prerelease 只对 GitHub 有用
  previewFeed(url: String!, assetPattern: String, prerelease: Boolean = false): FeedPreview!
  # RSS 订阅导出成 OPML(GitHub 订阅不在里面)
  exportOpml: String!

  # 剪藏:新的在前,进了回收站的不列
  clips(unreadOnly: Boolean = false, site: String, cursor: String): ClipPage!
  clipSites: [ClipSite!]!
  clip(id: ID!): Clip!
  # 某篇 .md 是不是剪藏;不是为 null
  nodeClip(nodeId: ID!): Clip
  clipPrefs: ClipPrefs!
}

# ---------- 变更 ----------

input PartEtag {
  partNumber: Int!
  etag: String!
}

input OAuthAuthorizationInput {
  clientId: String!
  redirectUri: String!
  responseType: String!
  scope: String
  state: String
  codeChallenge: String!
  codeChallengeMethod: String!
}

type Mutation {
  setMCPAccessRoot(credentialId: ID!, credentialType: String!, rootPath: String): Boolean!
  register(username: String!, password: String!): AuthPayload!
  login(username: String!, password: String!): AuthPayload!
  refresh: AuthPayload!
  logout: Boolean!

  changePassword(oldPassword: String!, newPassword: String!): AuthPayload!
  # 吊销一个登录设备。不能吊销当前会话 —— 那是 logout 该干的事。
  revokeSession(familyId: ID!): Boolean!

  createFolder(parentId: ID, name: String!): Node!
  # 根目录的「快传」文件夹,没有就建(幂等):「上传并复制分享链接」传上来的都放这里(doc/31 四)
  quickShareFolder: Node!
  renameNode(id: ID!, name: String!): Node!
  # 批量改名(doc/27):要么全改、要么都不改;批内互换名字可以;和这批之外的同名、批内重名 NAME_CONFLICT。整批一组动态,能一起撤回
  renameNodes(items: [RenameItem!]!): [Node!]!
  moveNodes(ids: [ID!]!, targetParentId: ID): [Node!]!
  copyNodes(ids: [ID!]!, targetParentId: ID): [Node!]!
  deleteNodes(ids: [ID!]!): Boolean!
  restoreNodes(ids: [ID!]!): [Node!]!
  purgeNodes(ids: [ID!]!): Boolean!
  purgeTrash: Boolean!

  # 收藏 / 取消收藏(doc/24);回收站里的跳过,返回改到的节点
  setStarred(ids: [ID!]!, starred: Boolean!): [Node!]!
  # 网页 / App 打开(预览、播放、下载)一个文件时上报,进「最近」;文件夹忽略
  markOpened(nodeId: ID!): Boolean!
  # 从「最近」里拿掉(文件本身不动);ids 不给 = 全部清掉
  clearRecent(ids: [ID!]): Boolean!
  # 把文件恢复成某个历史版本:现在的内容留成一个新版本,恢复本身也能反悔
  restoreFileVersion(id: ID!): Node!
  deleteFileVersions(ids: [ID!]!): Boolean!
  # 清空历史版本:给 nodeId 只清这个文件的,不给清自己全部文件的。返回释放的字节
  purgeFileVersions(nodeId: ID): Int64!

  # 在线编辑(doc/25):按节点覆盖内容,旧内容进历史版本;内容没变什么都不做。
  # baseSha256 是打开时的 sha256,对不上(在别处改过了)EDIT_CONFLICT;不给 = 不检查(「仍然保存」)
  saveTextFile(nodeId: ID!, content: String!, baseSha256: String): Node!
  # 新建文本文件(同名自动改名),内容可以为空
  createTextFile(parentId: ID, name: String!, content: String = ""): Node!

  # replace = true:目标位置有同名文件就覆盖它(旧内容进历史版本,doc/24),而不是自动改名;同名的是文件夹时照旧改名
  initUpload(parentId: ID, name: String!, sha256: String!, size: Int64!, replace: Boolean = false): UploadInit!
  completeUpload(sessionId: ID!, etags: [PartEtag!]!): Node!
  abortUpload(sessionId: ID!): Boolean!

  requestPreview(nodeId: ID!): PreviewInfo!
  # 把浏览器放不了的视频转成 mp4(doc/31 一);在转、转好了只回状态。分享访客在分享范围内也能用
  requestRemux(nodeId: ID!): RemuxInfo!

  createShare(nodeId: ID!, password: String, expiresAt: Time, allowUpload: Boolean = false): Share!
  revokeShare(id: ID!): Boolean!
  # 打开 / 关掉「允许对方上传」(只对文件夹分享)
  setShareUpload(id: ID!, allow: Boolean!): Boolean!
  verifySharePassword(token: String!, password: String!): ShareAuth!

  # 收集文件:属主侧
  createFileRequest(folderId: ID!, input: FileRequestInput!, password: String): FileRequest!
  updateFileRequest(id: ID!, input: FileRequestInput!): FileRequest!
  revokeFileRequest(id: ID!): Boolean!
  markFileRequestSeen(id: ID!): Boolean!
  # 收集文件:访客侧。openFileRequest 公开;其余要 openFileRequest 发的令牌。
  # 上传协议与 initUpload / completeUpload 相同,只是不传 sha256、没有秒传,complete 不返回节点。
  openFileRequest(token: String!, password: String, uploaderName: String): CollectAuth!
  collectInitUpload(name: String!, size: Int64!): UploadSession!
  collectCompleteUpload(sessionId: ID!, etags: [PartEtag!]!): CollectUpload!
  collectAbortUpload(sessionId: ID!): Boolean!

  # 分享访客往分享范围里的文件夹传文件(分享开着上传时,doc/32 一)。uploaderName 选填,记进动态与访问记录
  shareInitUpload(parentId: ID!, name: String!, size: Int64!, uploaderName: String): UploadSession!
  shareCompleteUpload(sessionId: ID!, etags: [PartEtag!]!): Node!
  shareAbortUpload(sessionId: ID!): Boolean!
  # 找到或建出 parent 里名叫 name 的文件夹(同名文件夹已在就用它)
  shareEnsureFolder(parentId: ID!, name: String!, uploaderName: String): Node!

  # WebDAV 应用密码:明文只在返回值出现一次
  createAppPassword(name: String!): String!
  revokeAppPassword(id: ID!): Boolean!

  createMCPAPIKey(name: String!, scopes: [String!]!): MCPAPIKeyCreated!
  revokeMCPAPIKey(id: ID!): Boolean!
  decideOAuthAuthorization(input: OAuthAuthorizationInput!, approved: Boolean!): OAuthAuthorizationResult!
  revokeOAuthGrant(id: ID!): Boolean!

  # 传输助手:body / nodeId 至少其一;nodeId 必须是当前用户的活跃节点。同一节点已在会话中则返回已有消息(幂等)。
  sendChatMessage(body: String, nodeId: ID): ChatMessage!
  # 删除一条消息(只删消息,不动附件文件)。不存在/非本人 → NOT_FOUND。
  deleteChatMessage(id: ID!): Boolean!
  # 幂等返回"我的设备"文件夹(首次调用才创建)。
  ensureChatFolder: Node!

  # 离线下载:每条链接一个任务,存到 parentId(null = 根目录)。一次最多 10 条,每人排队 + 进行中最多 10 个
  fetchUrls(urls: [String!]!, parentId: ID): [Job!]!
  # 解压:paths(包内完整路径)为空即 base 下的全部,解出的路径相对 base;
  # 解到 parentId 下的新文件夹(以压缩包名命名,撞名改名;null = 根目录)。后台执行,返回任务
  extractArchive(nodeId: ID!, base: String, paths: [String!], parentId: ID): Job!
  # 取消排队或进行中的任务(进行中的会停下并清掉已下载的部分)
  cancelJob(id: ID!): Job!
  # 失败或已取消的任务重新排队
  retryJob(id: ID!): Job!
  # 清掉已结束的任务记录(不动下好的文件),返回清掉的条数
  clearFinishedJobs: Int!

  # 影音:播放中每 15 秒、暂停、关闭时报一次;PDF 翻页后报。
  # 不记(5 分钟以下的音视频、3 页以下的 PDF、访客)时返回 null
  saveProgress(nodeId: ID!, position: Float!, duration: Float!): PlayProgress
  # 从「最近播放」里去掉
  clearProgress(nodeId: ID!): Boolean!

  # 通知:ids 为空 = 全部标为已读;返回标记的条数
  markNotificationsRead(ids: [ID!]): Int!
  # 删除全部通知,返回删除的条数
  clearNotifications: Int!
  createNotifyChannel(input: NotifyChannelInput!): NotifyChannel!
  updateNotifyChannel(id: ID!, input: NotifyChannelInput!): NotifyChannel!
  deleteNotifyChannel(id: ID!): Boolean!
  # 立即发一条测试消息;失败时报 NOTIFY_FAILED 并带上对方的回应
  testNotifyChannel(id: ID!): Boolean!

  # 直链:每个文件同时只有一条有效直链,重复调用返回已有的;一次最多 100 个
  createLinks(nodeIds: [ID!]!): [DirectLink!]!
  updateLink(id: ID!, input: DirectLinkInput!): DirectLink!
  pauseLink(id: ID!, paused: Boolean!): DirectLink!
  revokeLink(id: ID!): Boolean!
  setLinkPrefs(input: LinkPrefsInput!): LinkPrefs!
  adminPauseLink(id: ID!, paused: Boolean!): Boolean!
  adminRevokeLink(id: ID!): Boolean!

  adminCreateUser(username: String!, password: String!, quotaBytes: Int64): AdminUser!
  adminSetQuota(userId: ID!, quotaBytes: Int64!): AdminUser!
  adminSetDisabled(userId: ID!, disabled: Boolean!): AdminUser!
  # 生成随机新密码并吊销该用户全部会话;明文只在返回值出现一次
  adminResetPassword(userId: ID!): String!
  adminRetryFailedTasks: Int!

  # 撤回(从新到旧逐条,各自成败);撤回本身也记进动态
  undoActivities(selection: UndoSelection!): UndoResult!

  # 订阅:新建时先抓一次,地址不对当场报错(FEED_FETCH 类错误)
  createFeed(input: FeedInput!): Feed!
  updateFeed(id: ID!, input: FeedInput!): Feed!
  # 退订,已下好的文件不动
  deleteFeed(id: ID!): Boolean!
  # 立即检查一次(同步,最多 20 秒)
  refreshFeed(id: ID!): Feed!
  # 手动处理一个条目:DOWNLOAD 下附件 / CLIP 剪藏正文
  fetchFeedItem(itemId: ID!, mode: FeedMode!): FeedItem!
  # 导入 OPML:播客下载附件、其余只记录;不补下旧内容
  importOpml(opml: String!): OpmlImportResult!

  # 剪藏一个网页。html 是书签栏小工具发来的页面内容(≤ 5 MB,要登录才看得到的页面用);
  # 同一个地址剪过、那篇还在时默认直接给出已有的(force 重新剪)
  clipUrl(url: String!, html: String, force: Boolean = false): ClipResult!
  markClipRead(id: ID!, read: Boolean = true): Clip!
  setClipPrefs(input: ClipPrefsInput!): ClipPrefs!
}

type MCPAccessRoot { credentialId: ID!, credentialType: String!, rootId: ID!, rootName: String! }
type MCPAuditEvent { id: Int64!, credentialId: ID!, credentialType: String!, endpoint: String!, tool: String!, status: String!, errorCode: String, createdAt: Time! }

# ---------- 助手(doc/33) ----------

enum AiProviderKind { OPENAI, ANTHROPIC, GOOGLE, OPENAI_RESPONSES }

type AiProvider {
  id: ID!
  name: String!
  kind: AiProviderKind!
  baseUrl: String!
  # 第一个是默认
  models: [String!]!
  hasKey: Boolean!
  # 站点提供的(管理员配):只能经服务器转发
  site: Boolean!
  # 站点提供的:每人每天的 token 上限,0 = 不限
  dailyTokens: Int64!
  # 今天经服务器转发用掉的 token(当前用户)
  usedTokens: Int64!
  updatedAt: Time!
}

# key:null = 不变,"" = 清掉;dailyTokens 只对站点提供的有效
input AiProviderInput {
  name: String!
  kind: AiProviderKind!
  baseUrl: String!
  models: [String!]!
  key: String
  dailyTokens: Int64 = 0
}

enum AssistantPermission { ALLOW, ASK, DENY }

# 助手权限表的一行;scopes 是这组对应的 MCP scope,工具的 _meta["gopan/scopes"] 用的同一套
type AssistantGroup {
  key: String!
  label: String!
  scopes: [String!]!
  permission: AssistantPermission!
  defaultPermission: AssistantPermission!
  # 能把东西发到外面(公开链接、访问任意网址),改成允许时提示风险
  outbound: Boolean!
}

type AssistantAccess {
  disabled: Boolean!
  groups: [AssistantGroup!]!
}

input AssistantGroupInput {
  key: String!
  permission: AssistantPermission!
}

type AiConversation {
  id: ID!
  title: String!
  providerId: ID
  model: String!
  # 条目数,也是下一次追加的 fromSeq
  entries: Int!
  # 在哪跑:DEVICE(客户端,doc/33)/ SERVER(服务器,doc/34)
  runner: AiRunner!
  # 服务器上没跑完的这一轮的状态(列表上的「运行中」「等你确认」);没有为 null
  runStatus: AiRunStatus
  createdAt: Time!
  updatedAt: Time!
}

enum AiRunner { DEVICE, SERVER }
enum AiRunStatus { QUEUED, RUNNING, WAITING, DONE, FAILED, STOPPED }

# 服务器上跑的一轮(doc/34)
type AiRun {
  id: ID!
  conversationId: ID!
  status: AiRunStatus!
  # 等确认时的确认卡(JSON:title / names / more / detail / canAllowSession)
  approval: String
  error: String!
  createdAt: Time!
  startedAt: Time
  finishedAt: Time
}

extend type Query {
  # 服务器上能不能跑助手(装了运行环境)
  aiRunAvailable: Boolean!
  # 这个对话最近的一轮;没有为 null
  aiRun(conversationId: ID!): AiRun
  # 自己的 + 站点提供的(站点的在前)
  aiProviders: [AiProvider!]!
  # 管理员:站点提供的
  adminAiProviders: [AiProvider!]!
  # 直连用:只给自己的服务的 key;站点提供的一律拒绝
  aiProviderKey(id: ID!): String!
  assistantAccess: AssistantAccess!
  # 助手的长期记忆(doc/38):一份 Markdown,没有就是空串;name 这一版只有 USER.md
  aiMemory(name: String = "USER.md"): String!
  # 最近的在前;before 是上一页最后一个的 updatedAt
  aiConversations(before: Time, limit: Int = 50): [AiConversation!]!
  aiConversation(id: ID!): AiConversation!
  # 条目原样的 JSON 文本,从 fromSeq 起
  aiEntries(conversationId: ID!, fromSeq: Int = 0): [String!]!
}

extend type Mutation {
  createAiProvider(input: AiProviderInput!): AiProvider!
  # 管理员:建站点提供的
  adminCreateAiProvider(input: AiProviderInput!): AiProvider!
  # 自己的;管理员也能改 / 删站点提供的
  updateAiProvider(id: ID!, input: AiProviderInput!): AiProvider!
  deleteAiProvider(id: ID!): Boolean!
  # groups 只需给要改的组
  setAssistantAccess(disabled: Boolean!, groups: [AssistantGroupInput!]!): AssistantAccess!
  # 整份替换(空串 = 清空),最多 64 KB
  setAiMemory(name: String = "USER.md", content: String!): Boolean!
  createAiConversation(title: String!, providerId: ID, model: String): AiConversation!
  # fromSeq 必须等于现有条数,否则 CONFLICT(别的设备先写了)
  appendAiEntries(conversationId: ID!, fromSeq: Int!, entries: [String!]!): AiConversation!
  updateAiConversation(id: ID!, title: String, providerId: ID, model: String): AiConversation!
  deleteAiConversation(id: ID!): Boolean!
  # 交给服务器跑(doc/34):没有对话就先建;同一个对话同时只能有一轮(AI_RUN_BUSY)
  # images:随这句话发的图(data URL,JPEG / PNG / WebP / GIF),最多 4 张、合计 1 MB(doc/35)
  startAiRun(conversationId: ID, text: String!, context: String, providerId: ID!, model: String, images: [String!]): AiRun!
  # 确认卡的答复:once / session / deny
  answerAiRun(id: ID!, answer: String!): Boolean!
  stopAiRun(id: ID!): Boolean!
  setAiConversationRunner(id: ID!, runner: AiRunner!): Boolean!
}

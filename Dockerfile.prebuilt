# 小内存服务器部署路径之二:开发机没有 Docker 时,把 Go 二进制(前端已 embed)交叉编译好,
# 在服务器上只做一层 COPY,复用现有 gopan:latest 的运行时层(debian-slim + 静态 ffmpeg)。
# 机上零编译,内存占用可忽略。用法见 doc/09「升级 · 无 Docker 开发机」。
#
#   # 开发机(任意平台):
#   cd web && pnpm install --frozen-lockfile && pnpm build && cd ..
#   rm -rf server/cmd/gopan/dist && cp -r web/dist server/cmd/gopan/dist
#   cd server && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags='-s -w' -o ../gopan-linux ./cmd/gopan
#   scp ../gopan-linux Dockerfile.prebuilt <host>:/opt/gopan/
#   # 服务器:
#   cd /opt/gopan && docker build -f Dockerfile.prebuilt -t gopan:latest . \
#     && docker compose -f docker-compose.prod.yml up -d --no-build gopan
ARG BASE=gopan:latest
FROM ${BASE}
# v3.2 起内容搜索要 pdftotext:老的运行层没有就补装一次(apt 安装,不编译,小内存机器也扛得住);
# 之后的 gopan:latest 已经带着,这一步只是检查一下就过去
USER root
RUN command -v pdftotext >/dev/null 2>&1 || ( apt-get update \
    && apt-get install -y --no-install-recommends poppler-utils poppler-data \
    && rm -rf /var/lib/apt/lists/* )
COPY --chown=root:root --chmod=755 gopan-linux /usr/local/bin/gopan
USER gopan
